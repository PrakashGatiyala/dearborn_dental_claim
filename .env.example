# Copy this file to .env and fill in your values

AZURE_OPENAI_API_KEY=your-azure-openai-api-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# One Supabase Postgres database shared by all three systems.
# Vyne uses schema "vyne", the AS/400 uses "as400", Dearborn uses "public".
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<host>:6543/postgres

# Cloud APIs (Render) — used by vyne_sender.py, reset_demo.py, and local tooling
VYNE_API_URL=https://dearborn-dental-claim-2.onrender.com
AS400_API_URL=https://dearborn-dental-claim-1.onrender.com
DEARBORN_API_URL=https://dearborn-dental-claim.onrender.com

# Cloud portals (Netlify) — links in sender output; match Render *_PORTAL_URL on deploy
VYNE_PORTAL_URL=https://vynedearborndentalclaim.netlify.app
AS400_PORTAL_URL=https://as400dearborndentalclaim.netlify.app
DEARBORN_PORTAL_URL=https://dearborndentalclaim.netlify.app

# Optional: comma-separated browser origins (each Render service)
# ALLOWED_ORIGINS=https://vynedearborndentalclaim.netlify.app
# ALLOWED_ORIGINS=https://as400dearborndentalclaim.netlify.app
# ALLOWED_ORIGINS=https://dearborndentalclaim.netlify.app
